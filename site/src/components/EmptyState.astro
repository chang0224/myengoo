---
interface Props {
  message: string;
  hint?: string;
}

const { message, hint } = Astro.props;
---
<div data-testid="empty-state" class="flex flex-col items-center justify-center py-16 text-center">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="48"
    height="48"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    style="color: var(--muted, #6b7280); margin-bottom: 1rem;"
  >
    <rect x="3" y="3" width="18" height="18" rx="2" />
    <path d="M3 9h18M9 21V9" />
  </svg>
  <p style="color: var(--muted, #6b7280); font-size: 1rem; margin-bottom: 0.5rem;">{message}</p>
  {hint && <p style="color: var(--muted, #6b7280); font-size: 0.875rem;">{hint}</p>}
</div>
