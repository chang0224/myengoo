---
// PagefindSearch.astro — client-side search using Pagefind UI
const base = import.meta.env.BASE_URL;
---
<div id="pagefind-search" class="w-full max-w-sm"></div>

<link rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
<script define:vars={{ base }}>
  // pagefind-ui.js sets window.PagefindUI (not a named export)
  function initSearch() {
    if (typeof window.PagefindUI !== 'undefined') {
      new window.PagefindUI({
        element: '#pagefind-search',
        showImages: false,
        bundlePath: `${base}pagefind/`,
        resetStyles: false,
      });
    }
  }

  const script = document.createElement('script');
  script.src = `${base}pagefind/pagefind-ui.js`;
  script.onload = initSearch;
  document.head.appendChild(script);
</script>
