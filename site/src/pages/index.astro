---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const contents = await getCollection('contents');
const dailyNews = await getCollection('dailyNews');
const words = await getCollection('words');
---

<BaseLayout>
  <p>{contents.length} articles | {dailyNews.length} daily-news | {words.length} words</p>
</BaseLayout>
