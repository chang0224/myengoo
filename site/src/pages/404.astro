---
import BaseLayout from '../layouts/BaseLayout.astro';
const __keep = BaseLayout;
---
<BaseLayout title="페이지를 찾을 수 없어요">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h1 class="text-6xl font-bold mb-4" style="color: var(--muted);">404</h1>
    <p class="text-xl mb-2">찾으시는 페이지가 없어요</p>
    <p class="mb-8" style="color: var(--muted);">주소를 다시 확인해 주세요.</p>
    <a
      href={import.meta.env.BASE_URL}
      class="px-6 py-3 rounded-lg font-medium"
      style="background-color: var(--card-bg); border: 1px solid var(--border);"
    >
      홈으로 돌아가기
    </a>
  </div>
</BaseLayout>
