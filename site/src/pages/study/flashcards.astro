---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import Flashcard from '../../components/study/Flashcard';
import { loadStudyItems } from '../../lib/aggregator';

const { allItems } = await loadStudyItems();
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="플래시카드" description="단어와 뜻을 카드로 빠르게 점검합니다">
	<div class="mb-6 flex items-center justify-between">
		<div>
			<h1 class="text-2xl font-bold" style="color: var(--fg);">📇 플래시카드</h1>
			<p class="text-sm mt-1" style="color: var(--muted);">{allItems.length}개 항목 · Space=뒤집기, ←→=이동, S=셔플</p>
		</div>
		<a
			href={`${base}study/`}
			class="text-sm px-3 py-2 rounded-lg"
			style="color: var(--muted); border: 1px solid var(--border); min-height: 44px; display: inline-flex; align-items: center;"
		>
			← 학습 메뉴
		</a>
	</div>

	<div data-pagefind-ignore>
		{allItems.length === 0 ? (
			<EmptyState message="플래시카드로 만들 항목이 없어요" />
		) : (
			<Flashcard items={allItems} client:visible />
		)}
	</div>
</BaseLayout>
