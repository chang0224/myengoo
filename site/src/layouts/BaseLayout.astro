---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import PagefindSearch from '../components/PagefindSearch.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MyEngoo',
  description = 'Engoo 기사로 영어 공부하는 학습 아카이브',
} = Astro.props;

const pageTitle = title === 'MyEngoo'
  ? 'MyEngoo — 학습 아카이브'
  : `${title} | MyEngoo`;

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />

    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}android-chrome-192x192.png`} />
    <link rel="manifest" href={`${base}manifest.json`} />

    <!-- Dark mode: runs synchronously before first paint to prevent FOUC -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Password gate: hide content until authenticated -->
    <script is:inline>
      (function () {
        if (sessionStorage.getItem('authed') !== '1') {
          document.documentElement.dataset.locked = '1';
        }
      })();
    </script>
    <style>
      html[data-locked="1"] body > :not(#pw-gate) { display: none !important; }
      #pw-gate {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: var(--bg, #fff);
      }
      html.dark #pw-gate { background: var(--bg, #1a1a1a); }
      #pw-gate form {
        display: flex; flex-direction: column; align-items: center; gap: 12px;
        padding: 32px; border-radius: 12px;
        border: 1px solid var(--border, #e5e7eb);
        background: var(--surface, #fff);
      }
      html.dark #pw-gate form {
        border-color: var(--border, #333);
        background: var(--surface, #222);
      }
      #pw-gate input {
        padding: 8px 12px; border-radius: 6px; text-align: center;
        border: 1px solid var(--border, #d1d5db);
        background: var(--bg, #fff); color: var(--fg, #111);
        font-size: 1rem; width: 160px;
      }
      html.dark #pw-gate input {
        border-color: var(--border, #444);
        background: var(--bg, #1a1a1a); color: var(--fg, #eee);
      }
      #pw-gate button {
        padding: 8px 24px; border-radius: 6px; border: none; cursor: pointer;
        background: #2563eb; color: #fff; font-size: 0.95rem; font-weight: 500;
      }
      #pw-gate button:hover { background: #1d4ed8; }
      #pw-gate .error { color: #ef4444; font-size: 0.85rem; min-height: 1.2em; }
    </style>
  </head>
  <body class="min-h-screen">
    <div id="pw-gate">
      <form id="pw-form">
        <span style="font-size:1.5rem;">🔒</span>
        <input id="pw-input" type="password" placeholder="Password" autocomplete="off" autofocus />
        <button type="submit">확인</button>
        <span class="error" id="pw-error"></span>
      </form>
    </div>
    <script is:inline>
      (function () {
        if (sessionStorage.getItem('authed') === '1') {
          document.getElementById('pw-gate')?.remove();
          return;
        }
        document.getElementById('pw-form').addEventListener('submit', function (e) {
          e.preventDefault();
          var val = document.getElementById('pw-input').value;
          if (val === '0224') {
            sessionStorage.setItem('authed', '1');
            delete document.documentElement.dataset.locked;
            document.getElementById('pw-gate').remove();
          } else {
            document.getElementById('pw-error').textContent = '비밀번호가 틀렸습니다';
            document.getElementById('pw-input').value = '';
            document.getElementById('pw-input').focus();
          }
        });
      })();
    </script>
    <SiteHeader>
      <PagefindSearch slot="search" />
    </SiteHeader>
    <main class="max-w-4xl mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="mt-auto py-6 text-center text-sm" style="color: var(--muted);">
      © 2026 MyEngoo
    </footer>
  </body>
</html>
